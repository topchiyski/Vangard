{
  "name": "GET an existing user (ids 1-3)",
  "priority": 5,
  "request": { "method": "GET", "urlPathPattern": "/users/[1-3]" },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "users/user-{{request.pathSegments.[1]}}.json",
    "transformers": ["response-template"]
  }
}
