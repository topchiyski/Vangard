<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vanguard</groupId>
        <artifactId>vanguard-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Copy-paste starters for juniors. Compiled on every build so they never go stale; never run as tests. -->
    <artifactId>vanguard-templates</artifactId>
    <name>Vanguard :: Templates</name>

    <dependencies>
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-mobile</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-load</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                    <excludes>
                        <exclude>target/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
