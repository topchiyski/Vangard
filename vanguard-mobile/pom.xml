<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vanguard</groupId>
        <artifactId>vanguard-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vanguard-mobile</artifactId>
    <name>Vanguard :: Mobile</name>
    <description>Android + iOS (native, hybrid, mobile web) with Appium, locally or on BrowserStack.</description>

    <properties>
        <!-- Mobile tests need a device/emulator + Appium, so they only run with -Pmobile. -->
        <vanguard.mobile.skip>true</vanguard.mobile.skip>
        <!-- One device = one scenario at a time. -->
        <threads>1</threads>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-core</artifactId>
        </dependency>
        <!-- Mobile web tests reuse the web Page Objects (LoginPage, InventoryPage...) on real phones. -->
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.applitools</groupId>
            <artifactId>eyes-appium-java5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>${vanguard.mobile.skip}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>mobile</id>
            <properties>
                <vanguard.mobile.skip>false</vanguard.mobile.skip>
            </properties>
        </profile>
    </profiles>
</project>
