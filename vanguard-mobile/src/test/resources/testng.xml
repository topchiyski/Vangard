<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- ${threads} defaults to 1 in this module (one device = one scenario at a time). -->
<suite name="Vanguard Mobile" data-provider-thread-count="${threads}">
    <listeners>
        <listener class-name="com.vanguard.core.retry.RetryTransformer"/>
    </listeners>
    <test name="mobile">
        <classes>
            <class name="com.vanguard.mobile.runner.MobileTestRunner"/>
        </classes>
    </test>
</suite>
