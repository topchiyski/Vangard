<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- ${threads} is replaced at build time (default 4, override with -Dthreads=N). -->
<suite name="Vanguard API" data-provider-thread-count="${threads}">
    <listeners>
        <listener class-name="com.vanguard.core.retry.RetryTransformer"/>
    </listeners>
    <test name="api">
        <classes>
            <class name="com.vanguard.api.runner.ApiTestRunner"/>
        </classes>
    </test>
</suite>
